# ============================================================================
# GDG Design Studio - Google Cloud Platform (GCP) Environment Variables
# Copy this file to .env.local for local development
# ============================================================================

# 1. Google Cloud Project Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-northeast3

# 2. Google Cloud Storage (For Base Assets, Templates & Exported Designs)
GCS_BUCKET_NAME=your-gcp-project-id-gdg-design-assets

# 3. Vertex AI / Gemini API (For AI Speaker Photo Merge, Background Removal & Copywriting)
GEMINI_API_KEY=your-gemini-api-key
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash

# 4. Optional Service Account Key Path (Only for local testing if not using `gcloud auth application-default login`)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
